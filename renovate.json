{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "prConcurrentLimit": 3,
  "branchConcurrentLimit": 5,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the Keycloak version in the Dockerfile and README.",
      "managerFilePatterns": [
        "/^Dockerfile$/",
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "ARG KEYCLOAK_VERSION=(?<currentValue>[^\\s]+)",
        "Keycloak `(?<currentValue>[^`]+)`"
      ],
      "depNameTemplate": "quay.io/keycloak/keycloak",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["adoptium-java"],
      "matchPackageNames": ["java-jdk"],
      "allowedVersions": ">=17.0.0 <22"
    },
    {
      "matchManagers": ["maven"],
      "matchPackageNames": ["org.keycloak:keycloak-common", "org.keycloak:keycloak-core", "org.keycloak:keycloak-server-spi", "org.keycloak:keycloak-server-spi-private"],
      "groupName": "Keycloak runtime",
      "automerge": false
    },
    {
      "matchPackageNames": ["quay.io/keycloak/keycloak"],
      "groupName": "Keycloak runtime",
      "automerge": false
    }
  ]
}
